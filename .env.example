# ==========================================
# ExportLeads - Local Environment Configuration
# ==========================================

# 1. Local SQLite Database (stored at ./data/app.db)
DATABASE_URL="file:../data/app.db"

# 2. Google Cloud Places API (New) - for B2B discovery
# Get key from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY="AIzaSy-your-google-places-new-api-key"

# 3. Monthly Places API request safety cap (default 100)
MONTHLY_PLACES_REQUEST_LIMIT="100"

# 4. Google Gemini AI API - for B2B buyer classification
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy-your-gemini-api-key"

# 5. Optional Exporter Defaults
EXPORTER_COMPANY="Aura Crafts Exports"
EXPORTER_NAME="Avinash Singh"
EXPORTER_EMAIL="avinash@auracraftsexports.com"
EXPORTER_PHONE="+91 98110 23456"
EXPORTER_ADDRESS="Moradabad, Uttar Pradesh, India"

# 6. Logging Level (debug, info, warn, error)
LOG_LEVEL="info"
